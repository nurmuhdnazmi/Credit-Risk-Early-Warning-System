# Copy to secrets.toml for local testing of the Cloud path, or paste these
# keys into the Streamlit Community Cloud app's Secrets settings directly.
# Not needed for normal local development — dashboard/.env covers that.

DB_USER = "avnadmin"
DB_PASSWORD = "your_aiven_password_here"
DB_HOST = "your-service-name.aivencloud.com"
DB_PORT = "12793"
DB_NAME = "credit_risk_platform"

# Aiven's CA certificate. Paste the full contents of the downloaded ca.pem
# here (including the BEGIN/END CERTIFICATE lines), not a file path — Cloud
# secrets have no filesystem to point at.
DB_SSL_CA = """
-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----
"""
